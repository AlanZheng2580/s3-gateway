# Local test default. Keep this small so ./test-flow.sh can verify quota denial.
USER_BUCKET_QUOTA_SIZE=10MiB

# Recommended production-style starting point for one user uploading LLM models:
# USER_BUCKET_QUOTA_SIZE=1TiB

# LLM model uploads should normally keep S3 bucket versioning suspended.
# Supported values: suspend, enable, off, none, skip
USER_BUCKET_VERSIONING=suspend

# Cleanup abandoned multipart parts from interrupted large uploads.
MINIO_API_STALE_UPLOADS_EXPIRY=24h
MINIO_API_STALE_UPLOADS_CLEANUP_INTERVAL=1h

# Provisioned VersityGW admin user for gateway Web UI and admin API access.
VGW_ADMIN_ACCESS_KEY=versitygw-admin-key
VGW_ADMIN_SECRET_KEY=versitygw-admin-secret
