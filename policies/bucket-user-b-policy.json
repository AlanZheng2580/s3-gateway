{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyUserAOnBucketUserB",
      "Effect": "Deny",
      "Principal": "user-a-key",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::bucket-user-b",
        "arn:aws:s3:::bucket-user-b/*"
      ]
    },
    {
      "Sid": "AllowUserBListAndBucketRead",
      "Effect": "Allow",
      "Principal": "user-b-key",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::bucket-user-b"
    },
    {
      "Sid": "AllowUserBObjectReadWrite",
      "Effect": "Allow",
      "Principal": "user-b-key",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::bucket-user-b/*"
    }
  ]
}

